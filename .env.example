# Used by docker-compose.yml. Copy this file to ".env" (never commit .env) and fill in your own values.

# Database account. Use a long random password made of letters and numbers only
# (symbols like @ : / would break the database connection URL).
MONGO_ROOT_USERNAME=talenttrack_admin
MONGO_ROOT_PASSWORD=ChangeMeToALongRandomPassword123

# Secret for signing login tokens: at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:3000
NODE_ENV=production

# Optional: password for the local demo accounts created by the seed script
# (at least 8 characters with a letter and a number). Leave empty to generate a random one.
SEED_PASSWORD=
