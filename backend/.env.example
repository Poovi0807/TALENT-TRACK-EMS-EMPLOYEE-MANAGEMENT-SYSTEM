# For running the backend without Docker. Copy this file to "backend/.env" (never commit .env).

PORT=5000
MONGODB_URI=mongodb://localhost:27017/talenttrack

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Optional: password for the local demo accounts (8+ characters, a letter and a number).
# Leave empty and the seed script generates a random one and prints it once.
SEED_PASSWORD=
